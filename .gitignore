# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Local env files; keep sanitized examples
.env
.env.*
!.env.example
!.env.*.example

# Secrets, logs and test artifacts
*.key
*.p12
*.pfx
credentials.json
*service-account*.json
*service_account*.json
*-firebase-adminsdk-*.json
*.log
*.pid
/test-results/
/playwright-report/
.DS_Store
Thumbs.db
*.swp
*.swo

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# AGENTS.md, CLAUDE.md, agent configuration and memory are intentionally included.
